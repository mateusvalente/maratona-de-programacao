{
   "action": {
      "default title": "Open"
   },
   "background": {
      "service_worker": "service_worker.js",
      "type": "module"
   },
   "default_locale": "en",
   "description": "__MSG_general_extensionDescription__",
   "host_permissions": [ "https://designer.tools/" ],
   "icons": {
      "128": "icon128.png",
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_general_extensionName__",
   "permissions": [ "scripting", "activeTab", "storage", "webNavigation" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "5.6.2",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "media/*", "assets/*" ]
   } ]
}
