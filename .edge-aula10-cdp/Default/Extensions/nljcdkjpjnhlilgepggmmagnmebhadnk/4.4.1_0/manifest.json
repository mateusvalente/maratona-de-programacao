{
   "action": {
      "default_icon": "icon.png",
      "default_popup": "index.html",
      "default_title": "__MSG_appActionName__"
   },
   "background": {
      "service_worker": "background.js"
   },
   "content_scripts": [ {
      "css": [ "css/page_style.min.css" ],
      "js": [ "js/page_scripts.js" ],
      "matches": [ "\u003Call_urls>" ]
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'",
      "web_accessible_resources": "script-src 'self'; style-src 'self'"
   },
   "default_locale": "en",
   "description": "__MSG_appDesc__",
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "permissions": [ "activeTab", "storage", "identity" ],
   "short_name": "SiteChecker.pro",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.4.1",
   "web_accessible_resources": [ {
      "matches": [ "\u003Call_urls>" ],
      "resources": [ "css/page_style.min.css", "js/page_scripts.js", "images/logo.svg" ]
   } ]
}
